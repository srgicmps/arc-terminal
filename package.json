{
	"name": "arc-terminal",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"data": "node scripts/update.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"smoke": "node scripts/smoke.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.19.2",
		"fast-xml-parser": "^5.11.2",
		"fflate": "~0.8.3",
		"mdb-reader": "^3.2.0",
		"playwright-core": "^1.64.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
